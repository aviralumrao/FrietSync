DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_MS=900000

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

AWS_REGION=bucket_region
AWS_S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Base64 encoded 32-byte random key; generate locally and store outside source control.
GOOGLE_OAUTH_ENCRYPTION_KEY=
GOOGLE_OAUTH_FRONTEND_RESULT_URI=http://localhost:5173/settings/integrations
